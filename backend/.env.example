# CreatorSync backend service port
PORT=3001

# Comma-separated allowed origins. Use * for local development or open API access.
CORS_ORIGIN=*

# Local JSON file for publish history records
PUBLISH_HISTORY_FILE=./data/publish-history.json

# =========================
# DeepSeek AI Integration
# =========================
# Leave DEEPSEEK_API_KEY unset to use deterministic mock fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000

# Force mock mode even when a DeepSeek key is present.
AI_MOCK_MODE=false
# DEEPSEEK_MOCK_MODE=false

LOG_LEVEL=debug
