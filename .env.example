# Backend API
BACKEND_PORT=4000

# Frontend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# =========================
# Platform Adapter Config
# =========================
# Enable mock mode for local demo (no real AI required)
PLATFORM_ADAPTER_MODE=mock

# Enable/disable publishing simulation
MOCK_PUBLISH_ENABLED=true

# Local JSON file for publish history records
PUBLISH_HISTORY_FILE=./data/publish-history.json

# Default platform (optional)
DEFAULT_PLATFORM=xiaohongshu

# =========================
# Future AI Integration
# =========================
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# =========================
# Logging & Debug
# =========================
LOG_LEVEL=debug