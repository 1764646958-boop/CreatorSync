# CreatorSync local development defaults
PORT=3001
BACKEND_PORT=3001

# Frontend API base URL (Next.js and static preview use the backend on PORT)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# =========================
# Platform Adapter / Demo Config
# =========================
# Keep false/empty to use DeepSeek when DEEPSEEK_API_KEY is configured.
# Set AI_MOCK_MODE=true to force deterministic mock fallback for local demos.
AI_MOCK_MODE=false

# 模拟发布配置
MOCK_PUBLISH_ENABLED=true
PUBLISH_HISTORY_FILE=./data/publish-history.json

# Default platform (optional)
DEFAULT_PLATFORM=xiaohongshu

# =========================
# DeepSeek AI Integration
# =========================
# Leave DEEPSEEK_API_KEY unset to run with deterministic mock fallback.
DEEPSEEK_API_KEY=sk-c91a94e3c3184104a1c23c261879909f
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=30000

# =========================
# Logging & Debug
# =========================
LOG_LEVEL=debug
